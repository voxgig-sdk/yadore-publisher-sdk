              lit: "report"
            }
            {
              lit: "detail"
            }
          ]
          select: {
            exist: [
              "date"
              "format"
              "market"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.clicks`"
          }
        }
      ]
    }
  }



