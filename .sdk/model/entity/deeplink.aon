# Entity: deeplink

main: kit: entity: deeplink: {

  alias: field: {}

  fields: [
    {
      name: "deeplinks"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "found"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "isCouponing"
      req: false
      short: "If your project has in parts couponing traffic, you must use this parameter to tell the API if the click is a couponing click or not."
      type: "`$BOOLEAN`"
    }
    {
      name: "market"
      req: true
      short: "The market to query."
      type: "`$STRING`"
    }
    {
      name: "placementId"
      req: false
      short: "Your own subID for your click-tracking."
      type: "`$STRING`"
    }
    {
      name: "total"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "urls"
      req: true
      short: "An array of URLs"
      type: "`$ARRAY`"
    }
  ]

  name: "deeplink"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/v2/deeplink"
          parts: [
            "v2"
            "deeplink"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.result`"
          }
        }
      ]
    }
  }



}
