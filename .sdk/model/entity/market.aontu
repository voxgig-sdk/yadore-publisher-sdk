# Entity: market

main: kit: entity: market: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "market"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v2/markets"
          parts: [
            "v2"
            "markets"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.markets`"
          }
        }
      ]
    }
  }



}
