# Entity: offer

main: kit: entity: offer: {

  alias: field: {}

  fields: {
    availability: {
      h: "Availability"
      n: "availability"
      r: false
      t: "`$STRING`"
    }
    brand: {
      h: "Brand"
      n: "brand"
      r: false
      t: "`$STRING`"
    }
    clickUrl: {
      h: "Click Url"
      n: "clickUrl"
      r: false
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      t: "`$STRING`"
    }
    eer: {
      h: "Eer"
      n: "eer"
      r: false
      t: "`$STRING`"
    }
    estimatedCpc: {
      h: "Estimated Cpc"
      n: "estimatedCpc"
      r: false
      sh: "estimatedCPC means the gross revenue per click Yadore gets from its merchants, you have to use your revenue share to get your estimatedCPC."
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    image: {
      h: "Image"
      n: "image"
      r: false
      t: "`$OBJECT`"
    }
    merchant: {
      h: "Merchant"
