                          },
                          "hasSmartlinkHomepage": {
                            "description": "If the merchant accept homepage smartlinks.",
                            "type": "boolean"
                          },
                          "id": {
                            "type": "string"
                          },
                          "isSmartlink": {
                            "description": "If the merchant has one or more smartlinks.",
