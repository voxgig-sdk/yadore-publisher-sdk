            "in": "query",
            "name": "hasHomepage",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "If your project has mixed traffic, you can filter the merchants by using this parameter.",
            "in": "query",
            "name": "isCouponing",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
