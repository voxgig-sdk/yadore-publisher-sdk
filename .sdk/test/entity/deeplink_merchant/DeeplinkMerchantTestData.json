  "requests": {
    "GET /v2/deeplink/merchant": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "getDeeplinkMerchant",
        "parameters": [
          {
            "description": "Market to search. You can get the markets you are activated for with the Markets API.",
